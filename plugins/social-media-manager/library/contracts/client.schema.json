{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tdm:social-media-manager:contracts:client",
  "title": "Client",
  "x-version": 2,
  "description": "A client's brand profile, maintained by brand-keeper and read (as the short brand brief) by every stage. Every profile field is marked confirmed or guessed in `confidence`, with its basis. Logical record: the storage layer maps it to Google Sheets rows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_id",
    "client_code",
    "name",
    "status",
    "business_type",
    "city",
    "languages",
    "revision_cap",
    "next_job_number",
    "confidence",
    "open_questions",
    "learnings",
    "version",
    "changelog",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "client_id": {
      "description": "Stable kebab-case id, e.g. shubh-laundry.",
      "$ref": "#/$defs/slug"
    },
    "client_code": {
      "description": "Three capital letters used in job ids, e.g. SHL. Unique across clients.",
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "inactive"] },
    "business_type": { "type": "string", "description": "e.g. laundry, real estate developer, clothing store, travel agency." },
    "city": { "type": "string" },
    "contact_person": { "type": ["string", "null"] },
    "decision_maker": {
      "description": "Who has the final say on approvals at the client. Feedback from others without them is a multiple_voices conflict.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "whatsapp": {
      "description": "E.164 number, e.g. +919812345678. Never copy into evals, examples, logs or learnings.",
      "type": ["string", "null"],
      "pattern": "^\\+[1-9][0-9]{7,14}$"
    },
    "files_folder_url": {
      "description": "Google Drive folder holding the client's logo, references and brand material.",
      "type": ["string", "null"]
    },
    "onboarding_source": { "enum": ["interview", "material", "mixed", null] },

    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["Hindi", "English", "Hinglish"] }
    },
    "platforms": {
      "description": "Where the client posts, e.g. instagram, facebook, youtube, linkedin, whatsapp-status, google-business.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "posting_frequency": { "type": ["string", "null"], "description": "e.g. '3 reels + 2 posters per week'." },

    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "age_range": { "type": "string" },
        "locations": { "type": "array", "items": { "type": "string" } },
        "interests": { "type": "array", "items": { "type": "string" } },
        "customer_words": {
          "description": "How the client's customers describe the need or the business, in their own words (often Hinglish).",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "tone_of_voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "attributes": {
          "description": "3-5 voice attributes. The doesnt_mean column is what makes them usable.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "means", "doesnt_mean"],
            "properties": {
              "name": { "type": "string" },
              "means": { "type": "string" },
              "doesnt_mean": { "type": "string" },
              "example": { "type": "string", "description": "A real line from the client's material, if any." }
            }
          }
        },
        "by_platform": {
          "description": "How the tone shifts per platform; the voice stays the same.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "note"],
            "properties": {
              "platform": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "words": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use": { "type": "array", "items": { "type": "string" }, "description": "Terms the brand owns or always uses." },
        "never_use": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["word", "reason"],
            "properties": {
              "word": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "visual_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colours": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hex"],
            "properties": {
              "name": { "type": "string" },
              "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "use": { "type": "string", "description": "e.g. primary, accent, background." }
            }
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "use": { "type": "string", "description": "e.g. headings, body, Hindi text." }
            }
          }
        },
        "logo_ref": { "type": ["string", "null"], "description": "Drive link or path of the logo file." }
      }
    },
    "do": { "type": "array", "items": { "type": "string" } },
    "dont": { "type": "array", "items": { "type": "string" } },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref"],
        "properties": {
          "ref": { "type": "string", "description": "URL or Drive link." },
          "kind": { "enum": ["liked", "competitor", "own-past-work", "inspiration", "avoid"] },
          "note": { "type": "string" }
        }
      }
    },
    "own_handle": {
      "description": "The client's own Instagram handle, without @. Used by the own-account audit and to size competitors (within ~10x).",
      "type": ["string", "null"]
    },
    "competitors": {
      "description": "Accounts research compares against. Discovery adds them as guessed (auto-accepted unless config.competitor_confirm_required); a person can confirm or strike. Struck ones stay listed and are never used again.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle", "platform", "group", "reason", "confidence"],
        "properties": {
          "handle": { "type": "string", "description": "Public business or creator handle, without @." },
          "platform": { "$ref": "#/$defs/slug" },
          "group": {
            "description": "direct = same offer, a bit ahead; adjacent = same audience, different business; outsized = much bigger, for format only.",
            "enum": ["direct", "adjacent", "outsized"]
          },
          "reason": { "type": "string", "description": "One line: why this account." },
          "confidence": { "enum": ["confirmed", "guessed"] },
          "struck": { "type": "boolean" },
          "struck_by": { "type": ["string", "null"] },
          "added_on": { "type": ["string", "null"], "format": "date" }
        }
      }
    },
    "meta": {
      "description": "Optional link to the agency's Meta Business Manager. When linked, research can read the client's own posts through the Meta Ads connector without anyone logging in.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["linked"],
      "properties": {
        "linked": { "type": "boolean" },
        "ad_account_id": { "type": ["string", "null"], "pattern": "^[0-9]+$", "description": "Numeric, without act_." },
        "ig_account_id": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
        "page_id": { "type": ["string", "null"], "pattern": "^[0-9]+$" }
      }
    },
    "latest_insight_id": {
      "description": "The client's newest insight sheet. Operational, like next_job_number: updating it doesn't bump version or changelog.",
      "anyOf": [{ "type": "string", "pattern": "^[A-Z]{3}-I[0-9]{6}-[0-9]+$" }, { "type": "null" }]
    },
    "festival_calendar": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["occasion"],
        "properties": {
          "occasion": { "type": "string", "description": "e.g. Diwali, Holi, store anniversary." },
          "date": { "type": ["string", "null"], "description": "ISO date if fixed, else a month or note." },
          "priority": { "enum": ["high", "medium", "low"] },
          "note": { "type": "string" }
        }
      }
    },

    "price_points": {
      "description": "Prices the client is happy to show in creatives. Admin-only field.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "price"],
        "properties": {
          "item": { "type": "string" },
          "price": { "type": "number", "minimum": 0 },
          "currency": { "type": "string", "default": "INR" },
          "note": { "type": "string" }
        }
      }
    },
    "revision_cap": {
      "description": "Client revision rounds included per job. Admin-only field.",
      "type": "integer",
      "minimum": 0,
      "default": 2
    },
    "next_job_number": {
      "description": "Number for the client's next job id. Read and incremented in the same save as job creation.",
      "type": "integer",
      "minimum": 1
    },

    "learnings": {
      "description": "What the team found out by shipping. About 20 active entries; retire instead of deleting.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "kind", "what", "status"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "kind": { "enum": ["liked", "rejected", "decision", "correction"] },
          "what": { "type": "string", "description": "One sentence, specific enough to change a draft." },
          "evidence": { "type": "string", "description": "The job, the client's words, or the result behind it." },
          "applies_to": { "type": "string", "description": "e.g. reels, posters, captions, all." },
          "status": { "enum": ["active", "watch", "retired"] },
          "source_job": { "anyOf": [{ "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2,}$" }, { "type": "null" }] },
          "hook_formula_id": {
            "description": "(v2) Hook formula this learning is about (hooks/references/formula-catalog.md), so hooks can boost or penalise it.",
            "anyOf": [{ "type": "string", "pattern": "^H[0-9]{2}$" }, { "type": "null" }]
          },
          "angle_type": {
            "description": "(v2) Concept angle type this learning is about.",
            "enum": ["proof", "teach", "opinion", "story", "offer", null]
          },
          "outcome": {
            "description": "(v2) How a post using this formula or angle did: worked / flopped / mixed / untested. Read by concept and hooks.",
            "enum": ["worked", "flopped", "mixed", "untested", null]
          }
        }
      }
    },

    "confidence": {
      "description": "Per profile field: confirmed (said or approved by the client, admin or an editor) or guessed (inferred), plus where it came from.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "name", "business_type", "city", "contact_person", "decision_maker", "whatsapp",
          "languages", "platforms", "posting_frequency",
          "audience", "tone_of_voice", "words", "visual_identity",
          "do", "dont", "references", "festival_calendar",
          "price_points", "revision_cap",
          "own_handle", "competitors", "meta"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "enum": ["confirmed", "guessed"] },
          "basis": { "type": "string", "description": "Where the value came from, e.g. 'client said on call 12 Nov', 'inferred from Instagram bio'." }
        }
      }
    },
    "open_questions": {
      "description": "Every question carries a recommendation, so it is 'confirm or override', never a dead end.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "recommendation", "priority"],
        "properties": {
          "question": { "type": "string" },
          "recommendation": { "type": "string" },
          "priority": { "enum": ["high", "medium", "low"], "description": "high = blocks work; medium = improves quality; low = nice to have." },
          "field": { "type": ["string", "null"] }
        }
      }
    },

    "version": { "type": "integer", "minimum": 1 },
    "changelog": {
      "description": "Newest first. One entry per real change; typo fixes don't bump the version.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "change"],
        "properties": {
          "version": { "type": "integer", "minimum": 1 },
          "date": { "type": "string", "format": "date" },
          "by": { "type": "string" },
          "sections": { "type": "array", "items": { "type": "string" } },
          "change": { "type": "string", "description": "What changed and why, one line." }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
