{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tdm:social-media-manager:contracts:insight",
  "title": "Insight sheet",
  "description": "One market research run for one client, written by the research-methods skill (or the market-researcher subagent). Later stages read its `downstream` block through job.outputs.research. Every finding carries a source and a confidence mark; no commenter or reviewer identities are ever stored. Logical record: the storage layer maps it to the Insights and InsightFindings tabs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "insight_id",
    "client_id",
    "mode",
    "trigger",
    "situation",
    "methods_used",
    "cost",
    "findings",
    "pending_browser_step",
    "downstream",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "insight_id": {
      "description": "<client_code>-I<yyyymm>-<n>, e.g. SHL-I202611-1. n counts runs for that client in that month.",
      "type": "string",
      "pattern": "^[A-Z]{3}-I[0-9]{6}-[0-9]+$"
    },
    "client_id": { "$ref": "#/$defs/slug" },
    "mode": {
      "description": "unattended = no person needed (scheduled or background); attended = a person was online with a browser; mixed = both parts ran.",
      "enum": ["unattended", "attended", "mixed"]
    },
    "trigger": { "enum": ["onboarding", "intake", "schedule", "festival", "manual"] },
    "situation": {
      "description": "Router situations that applied; they can combine.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["new_client", "monthly_refresh", "festival", "local_service", "ad_heavy", "no_browser"] }
    },
    "festival": {
      "description": "For festival runs: the occasion from the client's festival calendar.",
      "type": ["string", "null"]
    },
    "methods_used": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "reason", "path", "status"],
        "properties": {
          "method": { "description": "Method id from methods-registry.md, e.g. ig-outlier-read.", "$ref": "#/$defs/slug" },
          "reason": { "type": "string", "description": "One line: why the router chose it." },
          "path": {
            "description": "installed-skill = a skill installed in the user's Claude ran it; fallback = our own module steps; apify = Apify actors; connector = a connected tool (Meta Ads); web = web search/fetch; pasted = numbers or text a person pasted.",
            "enum": ["installed-skill", "fallback", "apify", "connector", "web", "pasted"]
          },
          "skill": { "type": ["string", "null"], "description": "Name of the installed skill used, e.g. ig-viral." },
          "status": { "enum": ["done", "partial", "queued", "skipped", "failed"] },
          "note": { "type": "string", "description": "e.g. 'Meta connector missing: skipped'." }
        }
      }
    },
    "cost": {
      "description": "One line per provider used. Free methods cost 0. The same lines go to the job's credit ledger with their provider and currency.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "amount", "currency"],
        "properties": {
          "provider": { "enum": ["web", "meta", "browser", "apify", "other"] },
          "amount": { "type": "number", "minimum": 0 },
          "currency": { "enum": ["USD", "INR", "credits"] },
          "estimate": { "type": ["number", "null"], "minimum": 0 },
          "approved_by": { "type": ["string", "null"], "description": "Admin handle for a paid run above the auto-approve limit." },
          "note": { "type": "string" }
        }
      }
    },
    "competitors_analysed": {
      "description": "Business or creator accounts read in this run. Public accounts only; never private people.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle", "platform"],
        "properties": {
          "handle": { "type": "string" },
          "platform": { "$ref": "#/$defs/slug" },
          "group": { "enum": ["direct", "adjacent", "outsized", null] },
          "followers": { "type": ["integer", "null"], "minimum": 0 },
          "median_views": { "type": ["number", "null"], "minimum": 0, "description": "Median views of the account's recent reels: the baseline for outlier multiples." },
          "items_read": { "type": ["integer", "null"], "minimum": 0 },
          "note": { "type": "string" }
        }
      }
    },
    "own_account": {
      "description": "The client's own account, when it could be read (Meta connector, pasted Insights, or a browser read).",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["handle", "metrics_source", "posts_read"],
      "properties": {
        "handle": { "type": "string" },
        "metrics_source": { "enum": ["meta-connector", "pasted", "browser", "installed-skill"] },
        "period_from": { "type": ["string", "null"], "format": "date" },
        "period_to": { "type": ["string", "null"], "format": "date" },
        "posts_read": { "type": "integer", "minimum": 0 },
        "median_views": { "type": ["number", "null"], "minimum": 0 },
        "top": { "type": "array", "items": { "$ref": "#/$defs/ownPost" }, "maxItems": 5 },
        "bottom": { "type": "array", "items": { "$ref": "#/$defs/ownPost" }, "maxItems": 5 },
        "diagnosis": { "type": "string", "description": "e.g. 'views but no follows: profile problem'." }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pain_points", "working_angles", "outlier_hooks", "competitors_overdo", "timely_hooks",
        "customer_phrases", "proof_points", "visual_cliches", "competitor_ads"
      ],
      "properties": {
        "pain_points": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "working_angles": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "outlier_hooks": { "type": "array", "items": { "$ref": "#/$defs/outlierHook" } },
        "competitors_overdo": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "timely_hooks": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "customer_phrases": { "type": "array", "items": { "$ref": "#/$defs/customerPhrase" } },
        "proof_points": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "visual_cliches": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "competitor_ads": { "type": "array", "items": { "$ref": "#/$defs/competitorAd" } }
      }
    },
    "widened": {
      "description": "If the niche was too small: what the research widened to (category or city level), so readers know.",
      "type": ["string", "null"]
    },
    "not_read": {
      "description": "Sources that were blocked, missing or not checked. A blocked source is never reported as 'nothing found'.",
      "type": "array",
      "items": { "type": "string" }
    },
    "diff_vs_previous": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["previous_insight_id", "summary"],
      "properties": {
        "previous_insight_id": { "type": "string", "pattern": "^[A-Z]{3}-I[0-9]{6}-[0-9]+$" },
        "summary": { "type": "string", "description": "What changed since last time, a few lines. 'No change' only covers what was re-read." },
        "new": { "type": "array", "items": { "type": "string" }, "description": "Finding ids new in this run." },
        "gone": { "type": "array", "items": { "type": "string" }, "description": "Earlier findings no longer supported, as short text." },
        "changed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["what", "before", "after"],
            "properties": {
              "what": { "type": "string" },
              "before": { "type": "string" },
              "after": { "type": "string" }
            }
          }
        }
      }
    },
    "pending_browser_step": {
      "description": "The attended Instagram read, when it is still to do. pending=false once it has run (or is not needed).",
      "type": "object",
      "additionalProperties": false,
      "required": ["pending"],
      "properties": {
        "pending": { "type": "boolean" },
        "methods": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "task_id": { "type": ["string", "null"], "pattern": "^T-[0-9]{8}-[0-9]+$" },
        "estimate_minutes": { "type": ["integer", "null"], "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "raw_files": {
      "description": "Where raw captures live: Drive links (Sheets mode) or paths under the data folder (files mode). Never inside the plugin folder.",
      "type": "array",
      "items": { "type": "string" }
    },
    "ran_without_subagent": { "type": "boolean", "description": "True when the skill ran the flow inline (claude.ai chat, or no subagent support)." },
    "summary": { "type": "string", "description": "The short chat summary returned at the end of the run." },
    "downstream": { "$ref": "#/$defs/downstream" },
    "version": { "type": "integer", "minimum": 1, "description": "Increments on every save, including pins and strikes." },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "findingId": { "type": "string", "pattern": "^F[0-9]+$" },

    "findingBase": {
      "type": "object",
      "required": ["id", "text", "source", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/findingId", "description": "Unique inside this insight; stable across pins, strikes and outcomes." },
        "text": { "type": "string", "minLength": 1, "description": "One specific, usable sentence. Customer phrases: exactly as written." },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "A link (business pages, ads, competitor posts) or an anonymised reference ('#indorelaundry reels scan 2026-11-20, 7 of 30'; 'Google reviews of 3 Vijay Nagar laundries, 30 read'). Never a commenter's or reviewer's name or handle."
        },
        "confidence": {
          "description": "strong = repeated across several independent sources or a solid sample; some = a pattern in one source or a small sample; weak = a single item or an inference.",
          "enum": ["strong", "some", "weak"]
        },
        "pinned": { "type": "boolean", "description": "Editor marked it as especially useful. Pinned items go first in downstream." },
        "struck": { "type": "boolean", "description": "Editor ruled it out. Struck findings never reach downstream." },
        "used_in_jobs": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2,}$" } },
        "outcome": { "enum": ["worked", "didnt", "unknown"], "description": "Learning loop, filled after delivery when results are known." },
        "outcome_note": { "type": "string", "description": "e.g. 'SHL-04 reel: 3.4x the account median'." }
      }
    },
    "finding": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/findingBase" }],
      "unevaluatedProperties": false
    },
    "customerPhrase": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/findingBase" }],
      "required": ["language"],
      "properties": {
        "language": { "enum": ["Hindi", "English", "Hinglish"] }
      },
      "unevaluatedProperties": false
    },
    "outlierHook": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/findingBase" }],
      "required": ["details"],
      "properties": {
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["account", "multiple", "formula"],
          "properties": {
            "account": { "type": "string", "description": "The business or creator account the reel came from (public)." },
            "multiple": { "type": "number", "minimum": 0, "description": "Views ÷ that account's own recent median." },
            "views": { "type": ["integer", "null"], "minimum": 0 },
            "formula": { "type": "string", "description": "Hook formula id (IG1-IG10), 'unclassified' or a short name." },
            "formula_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "hook_visual": { "type": "string" },
            "hook_spoken": { "type": "string" },
            "hook_text": { "type": "string" },
            "format": { "type": "string", "description": "e.g. talking head, before/after, POV, process." },
            "length_s": { "type": ["number", "null"], "minimum": 0 },
            "structure": { "type": "string" },
            "cta": { "type": "string" }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "competitorAd": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/findingBase" }],
      "required": ["details"],
      "properties": {
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["advertiser"],
          "properties": {
            "advertiser": { "type": "string", "description": "Page name of the business running the ad." },
            "days_running": { "type": ["integer", "null"], "minimum": 0 },
            "versions": { "type": ["integer", "null"], "minimum": 1 },
            "reason_to_buy": { "type": "string" },
            "hook_type": { "type": "string" },
            "offer": { "type": "string" },
            "format": { "type": "string" },
            "language": { "enum": ["Hindi", "English", "Hinglish", null] },
            "status_read": { "type": "string", "description": "test (<14 days), survived (30+), likely working (60+ with versions; inferred)." }
          }
        }
      },
      "unevaluatedProperties": false
    },

    "ownPost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "multiple"],
      "properties": {
        "ref": { "type": "string", "description": "Permalink or date + first words of the client's own post." },
        "multiple": { "type": "number", "minimum": 0 },
        "views": { "type": ["integer", "null"], "minimum": 0 },
        "formula": { "type": ["string", "null"] },
        "hold_3s": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "sends_per_reach": { "type": ["number", "null"], "minimum": 0 },
        "follows_per_reach": { "type": ["number", "null"], "minimum": 0 },
        "non_follower_share": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },

    "handoffItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/findingId" },
        "text": { "type": "string" },
        "confidence": { "enum": ["strong", "some", "weak"] },
        "language": { "enum": ["Hindi", "English", "Hinglish"] },
        "formula": { "type": "string" },
        "multiple": { "type": "number", "minimum": 0 }
      }
    },
    "downstream": {
      "description": "The handoff block later stages read (copied into job.outputs.research). Built from non-struck findings, pinned first, strong before some before weak.",
      "type": "object",
      "additionalProperties": false,
      "required": ["brief", "concept_and_hooks", "script", "localise", "visuals"],
      "properties": {
        "brief": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pain_points", "working_angles", "timely_hooks"],
          "properties": {
            "pain_points": { "type": "array", "items": { "$ref": "#/$defs/handoffItem" } },
            "working_angles": { "type": "array", "items": { "$ref": "#/$defs/handoffItem" } },
            "timely_hooks": { "type": "array", "items": { "$ref": "#/$defs/handoffItem" } }
          }
        },
        "concept_and_hooks": {
          "description": "For the concept and hooks stages.",
          "type": "object",
          "additionalProperties": false,
          "required": ["working_angles", "outlier_hooks", "competitors_overdo"],
          "properties": {
            "working_angles": { "type": "array", "items": { "$ref": "#/$defs/handoffItem" } },
            "outlier_hooks": { "type": "array", "items": { "$ref": "#/$defs/handoffItem" } },
            "competitors_overdo": { "type": "array", "items": { "$ref": "#/$defs/handoffItem" } }
          }
        },
        "script": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proof_points"],
          "properties": {
            "proof_points": { "type": "array", "items": { "$ref": "#/$defs/handoffItem" } }
          }
        },
        "localise": {
          "type": "object",
          "additionalProperties": false,
          "required": ["customer_phrases"],
          "properties": {
            "customer_phrases": { "type": "array", "items": { "$ref": "#/$defs/handoffItem" } }
          }
        },
        "visuals": {
          "description": "For shot-sourcing and style-bible: clichés to avoid.",
          "type": "object",
          "additionalProperties": false,
          "required": ["visual_cliches"],
          "properties": {
            "visual_cliches": { "type": "array", "items": { "$ref": "#/$defs/handoffItem" } }
          }
        }
      }
    }
  }
}
