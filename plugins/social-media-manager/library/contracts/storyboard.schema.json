{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tdm:social-media-manager:contracts:storyboard",
  "$comment": "draft — completed in its group (Group 2, pre-production)",
  "title": "Storyboard",
  "type": "object",
  "required": ["job_id", "shots"],
  "properties": {
    "job_id": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2,}$" },
    "aspect_ratio": { "type": "string" },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot": { "type": "integer", "minimum": 1 },
          "duration_sec": { "type": "number", "minimum": 0 },
          "description": { "type": "string" },
          "script_beat": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
