{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tdm:social-media-manager:presets:preset",
  "title": "Style preset",
  "description": "A reusable editing style. One file per preset in library/presets/<name>.yaml (or .json).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "avg_shot_length_sec",
    "pacing",
    "transitions",
    "caption_style",
    "music_mood",
    "bpm_range",
    "color_grade",
    "hook_formula",
    "end_card"
  ],
  "properties": {
    "name": {
      "description": "kebab-case, matches the file name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 200 },
    "avg_shot_length_sec": { "type": "number", "exclusiveMinimum": 0 },
    "pacing": { "enum": ["slow", "medium", "fast", "very-fast"] },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "caption_style": {
      "description": "e.g. 'word-by-word pop, bold sans, yellow highlight'.",
      "type": "string"
    },
    "music_mood": { "type": "string" },
    "bpm_range": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 40, "maximum": 220 },
        { "type": "integer", "minimum": 40, "maximum": 220 }
      ],
      "items": false,
      "minItems": 2
    },
    "color_grade": { "type": "string" },
    "hook_formula": { "type": "string" },
    "end_card": {
      "description": "What the final frame shows, e.g. 'logo + CTA + handle, 2s'.",
      "type": "string"
    }
  }
}
